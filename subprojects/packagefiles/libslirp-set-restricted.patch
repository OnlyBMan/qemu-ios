     g_free(slirp);
 }
 
+void slirp_set_restricted(Slirp *slirp, int restricted)
+{
+    slirp->restricted = restricted;
+}
+
+void slirp_set_local_network(Slirp *slirp, int allowed)
+{
+    slirp->local_network_blocked = !allowed;
+}
+
+void slirp_set_dns_forward(Slirp *slirp, const struct sockaddr_in *addr)
+{
+    memset(&slirp->dns_forward, 0, sizeof(slirp->dns_forward));
+    if (addr) {
+        slirp->dns_forward = *addr;
+    }
+}
+
+static int slirp_destination_class4(const uint8_t *b)
+{
+    if (b[0] == 0 || b[0] == 127) {
+        return SLIRP_DESTINATION_HOST;
+    }
+    if (b[0] == 10 || (b[0] == 172 && (b[1] & 0xf0) == 16) ||
+        (b[0] == 192 && b[1] == 168) || (b[0] == 169 && b[1] == 254) ||
+        (b[0] == 100 && (b[1] & 0xc0) == 64) || (b[0] == 198 && (b[1] & 0xfe) == 18) ||
+        b[0] >= 224) {
+        return SLIRP_DESTINATION_LOCAL;
+    }
+    return SLIRP_DESTINATION_PUBLIC;
+}
+
+int slirp_destination_class(const struct sockaddr *addr)
+{
+    static const uint8_t zero[12], nat64[12] = { 0, 0x64, 0xff, 0x9b };
+    const uint8_t *b;
+
+    if (addr->sa_family == AF_INET) {
+        return slirp_destination_class4(
+            (const uint8_t *)&((const struct sockaddr_in *)addr)->sin_addr);
+    }
+    if (addr->sa_family != AF_INET6) {
+        return SLIRP_DESTINATION_HOST;
+    }
+    b = ((const struct sockaddr_in6 *)addr)->sin6_addr.s6_addr;
+    if ((!memcmp(b, zero, 10) && b[10] == 0xff && b[11] == 0xff) ||  /* v4-mapped */
+        (!memcmp(b, zero, 8) && b[8] == 0xff && b[9] == 0xff &&
+         !b[10] && !b[11]) ||                                         /* v4-translated */
+        !memcmp(b, zero, 12) ||                       /* v4-compatible, :: and ::1 */
+        !memcmp(b, nat64, 12)) {
+        return slirp_destination_class4(b + 12);
+    }
+    if ((b[0] & 0xfe) == 0xfc || (b[0] == 0xfe && (b[1] & 0x80)) || b[0] == 0xff) {
+        return SLIRP_DESTINATION_LOCAL;
+    }
+    return SLIRP_DESTINATION_PUBLIC;
+}
+
+/* The address an IPv6 one carries (as slirp_destination_class reads it), 4 or 16 bytes into `out`. */
+static size_t slirp_destination_bytes(const struct sockaddr *addr, uint8_t out[16])
+{
+    static const uint8_t zero[12], nat64[12] = { 0, 0x64, 0xff, 0x9b };
+    const uint8_t *b;
+
+    if (addr->sa_family == AF_INET) {
+        memcpy(out, &((const struct sockaddr_in *)addr)->sin_addr, 4);
+        return 4;
+    }
+    if (addr->sa_family != AF_INET6) {
+        return 0;
+    }
+    b = ((const struct sockaddr_in6 *)addr)->sin6_addr.s6_addr;
+    if ((!memcmp(b, zero, 10) && b[10] == 0xff && b[11] == 0xff) ||
+        (!memcmp(b, zero, 8) && b[8] == 0xff && b[9] == 0xff && !b[10] && !b[11]) ||
+        !memcmp(b, zero, 12) || !memcmp(b, nat64, 12)) {
+        memcpy(out, b + 12, 4);
+        return 4;
+    }
+    memcpy(out, b, 16);
+    return 16;
+}
+
+#ifndef _WIN32
+#include <ifaddrs.h>
+#endif
+
+/* One of the host's own interface addresses (read again at most every 5 s):
+ * its services listening on every interface are behind it, so an address
+ * that would otherwise be public is the local network. */
+static bool slirp_host_own_address(const struct sockaddr *addr)
+{
+#ifdef _WIN32
+    return false;
+#else
+    static uint8_t own[64][16];
+    static size_t own_len[64], own_count;
+    static int64_t read_at;
+    static bool have_read;
+    int64_t now = g_get_monotonic_time();
+    uint8_t want[16];
+    size_t len = slirp_destination_bytes(addr, want);
+
+    if (!have_read || now - read_at > 5 * G_USEC_PER_SEC) {
+        struct ifaddrs *list, *i;
+        own_count = 0;
+        if (getifaddrs(&list) == 0) {
+            for (i = list; i && own_count < 64; i = i->ifa_next) {
+                if (i->ifa_addr && (own_len[own_count] =
+                        slirp_destination_bytes(i->ifa_addr, own[own_count]))) {
+                    own_count++;
+                }
+            }
+            freeifaddrs(list);
+        }
+        read_at = now;
+        have_read = true;
+    }
+    for (size_t n = 0; len && n < own_count; n++) {
+        if (own_len[n] == len && !memcmp(own[n], want, len)) {
+            return true;
+        }
+    }
+    return false;
+#endif
+}
+
+bool slirp_destination_allowed(Slirp *slirp, const struct sockaddr *addr)
+{
+    int c = slirp_destination_class(addr);
+    if (c == SLIRP_DESTINATION_PUBLIC && slirp_host_own_address(addr)) {
+        c = SLIRP_DESTINATION_LOCAL;
+    }
+    return c == SLIRP_DESTINATION_PUBLIC ||
+           (c == SLIRP_DESTINATION_LOCAL && !slirp->local_network_blocked);
+}
