diff --git a/src/libslirp.h b/src/libslirp.h
index 240dfe8b..4607168e 100644
--- a/src/libslirp.h
+++ b/src/libslirp.h
@@ -268,6 +268,51 @@ Slirp *slirp_init(int restricted, bool in_enabled, struct in_addr vnetwork,
 SLIRP_EXPORT
 void slirp_cleanup(Slirp *slirp);
 
+/* Change the "restricted" flag on a running instance, in place. With it set,
+ * the guest may only reach the gateway services (DHCP/DNS and forwards);
+ * cleared, guest-initiated outbound connections are allowed again. Takes
+ * effect on the next connection attempt -- no link event, no DHCP change. */
+SLIRP_EXPORT
+void slirp_set_restricted(Slirp *slirp, int restricted);
+
+/* Where guest traffic may go on the host's side, by the address a connection
+ * or datagram would be sent to (LightTouchMac's NetworkPolicy is the same rule):
+ *   SLIRP_DESTINATION_HOST    the host itself (0/8, 127/8, ::, ::1): never, so
+ *                             the gateway's address does not lead to the host's
+ *                             loopback services either;
+ *   SLIRP_DESTINATION_LOCAL   its local networks (10/8, 172.16/12, 192.168/16,
+ *                             169.254/16, 100.64/10, 198.18/15, 224/3, fc00::/7,
+ *                             fe80::/10, fec0::/10, ff00::/8): while
+ *                             slirp_set_local_network allows;
+ *   SLIRP_DESTINATION_PUBLIC  everything else.
+ * Allowing a connection, the host's own interface addresses that would
+ * otherwise be public count as local.
+ * An IPv6 address carrying an IPv4 one (v4-mapped, v4-translated, v4-compatible,
+ * NAT64 64:ff9b::/96) is judged as that IPv4 address. The guest's DNS to its
+ * virtual nameserver is the one exemption: the host's resolver may sit on the
+ * LAN or on loopback. Any other address family is SLIRP_DESTINATION_HOST. */
+enum {
+    SLIRP_DESTINATION_PUBLIC,
+    SLIRP_DESTINATION_LOCAL,
+    SLIRP_DESTINATION_HOST,
+};
+SLIRP_EXPORT
+int slirp_destination_class(const struct sockaddr *addr);
+
+/* Allow or refuse guest traffic to SLIRP_DESTINATION_LOCAL destinations.
+ * Refused, such a connection or datagram fails as if unreachable; the host's own
+ * DNS server (the guest's 10.0.2.3) stays reachable unless slirp_set_dns_forward
+ * gives a resolver instead. Allowed by default; takes effect on the next connection. */
+SLIRP_EXPORT
+void slirp_set_local_network(Slirp *slirp, int allowed);
+
+/* While the local network is refused, the guest's UDP DNS (to its virtual
+ * nameserver, port 53) goes to `addr` -- a resolver on the host's loopback that
+ * asks the system resolver -- instead of the host's DNS server, which usually
+ * sits on the LAN; other DNS to the virtual nameserver is refused. NULL clears. */
+SLIRP_EXPORT
+void slirp_set_dns_forward(Slirp *slirp, const struct sockaddr_in *addr);
+
 /* This is deprecated, use slirp_pollfds_fill_socket instead. */
 SLIRP_EXPORT
 void slirp_pollfds_fill(Slirp *slirp, uint32_t *timeout,
