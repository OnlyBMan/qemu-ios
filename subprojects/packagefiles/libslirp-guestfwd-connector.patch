+struct gfwd_list *add_connector(struct gfwd_list **ex_ptr,
+                                SlirpConnectCb connect_cb, void *opaque,
+                                struct in_addr addr, int port)
+{
+    struct gfwd_list *f = add_guestfwd(ex_ptr, NULL, opaque, addr, port);
+
+    f->connect_cb = connect_cb;
+
+    return f;
+}
