     for (; *ex_ptr != NULL; ex_ptr = &((*ex_ptr)->ex_next)) {
@@ -255,6 +266,22 @@ int fork_exec(struct socket *so, const char *ex)
     return 1;
 }
 
+int open_connected(struct socket *so, int s)
+{
+    DEBUG_CALL("open_connected");
+    DEBUG_ARG("so = %p", so);
+
+    if (not_valid_socket(s)) {
+        return 0;
+    }
+
+    so->s = s;
+    slirp_set_nonblock(so->s);
+    slirp_register_poll_socket(so);
+
+    return 1;
+}
