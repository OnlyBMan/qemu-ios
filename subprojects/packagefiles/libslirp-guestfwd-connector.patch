+/* Expose to the guest, on the given address and port, a socket connect_cb
+ * connects for each connection */
+struct gfwd_list *add_connector(struct gfwd_list **ex_ptr,
+                                SlirpConnectCb connect_cb, void *opaque,
+                                struct in_addr addr, int port);
+
+/* Take the socket a connector made for the guest connection so; 0 if none */
+int open_connected(struct socket *so, int s);
+
 /* Remove the guest forward bound to the given address and port */
 int remove_guestfwd(struct gfwd_list **ex_ptr, struct in_addr addr, int port);
 
diff --git a/src/slirp.c b/src/slirp.c
index 9f0c944..6f2863f 100644
--- a/src/slirp.c
+++ b/src/slirp.c
@@ -1775,6 +1775,19 @@ int slirp_add_guestfwd(Slirp *slirp, SlirpWriteCb write_cb, void *opaque,
     return 0;
 }
 
+int slirp_add_guestfwd_connector(Slirp *slirp, SlirpConnectCb connect_cb,
+                                 void *opaque, struct in_addr *guest_addr,
+                                 int guest_port)
+{
+    if (!check_guestfwd(slirp, guest_addr, guest_port)) {
+        return -1;
+    }
+
+    add_connector(&slirp->guestfwd_list, connect_cb, opaque, *guest_addr,
+                  htons(guest_port));
+    return 0;
+}
