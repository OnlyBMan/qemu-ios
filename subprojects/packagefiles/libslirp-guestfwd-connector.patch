+/* Called for each connection the guest opens to a forward added with
+ * slirp_add_guestfwd_connector: a connected stream socket for it, which slirp
+ * owns from then on, or a negative value to refuse the connection. */
+typedef int (*SlirpConnectCb)(void *opaque);
+
+/* Set up port forwarding between a port in the guest network and a socket
+ * the application connects for each guest connection (as slirp_add_unix does
+ * by path, without the path) */
+SLIRP_EXPORT
+int slirp_add_guestfwd_connector(Slirp *slirp, SlirpConnectCb connect_cb,
+                                 void *opaque, struct in_addr *guest_addr,
+                                 int guest_port);
+
 /* TODO: rather identify a guestfwd through an opaque pointer instead of through
  * the guest_addr */
 
